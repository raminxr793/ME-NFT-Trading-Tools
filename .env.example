# ME NFT Trading Tools — NEVER commit your real .env file

# Solana RPC provider (Alchemy, Helius, Triton, QuickNode, etc.)
SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional Magic Eden API credentials — required only for me_nft_trader_api.js
# Keep API_MODE=dry-run until Magic Eden approves the key and the response schema is verified.
ME_API_KEY=
ME_API_BASE=https://api-mainnet.magiceden.dev/v2
API_MODE=dry-run

# Shared Escrow account created/funded through Magic Eden's UI
SHARED_ESCROW_ACCOUNT=
AUTO_FUND_SHARED_ESCROW=false

# Magic Eden MMM pool metadata (extract from UI-created offer)
ME_REFERRAL_PUBKEY=8d7dmXFxP9YKubdfo3JeFYUYfC1C65HHtw9tAGsg934z
ME_BUYSIDE_CREATOR_ROYALTY_BP=10000
COLLECTION_ALLOWLISTS_FILE=collection_allowlists.json

# Telegram is optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading limits — apply separately to each configured bot wallet
MAX_SOL_PER_TRADE=0.10
MAX_SOL_PER_DAY=0.50
MIN_PERCENT_BELOW_FLOOR=1
FLOOR_GAP_CANCEL_PERCENT=1
LOW_BALANCE_THRESHOLD_SOL=0.05
ME_FEE_RATE=0.02

# Polling and transaction tuning
POLL_INTERVAL_MS=15000
CHECK_INTERVAL_MS=60000
BALANCE_CHECK_INTERVAL_MS=900000
DAILY_SUMMARY_INTERVAL_MS=86400000
FLOOR_PRICE_CACHE_TTL_MS=120000
COMPUTE_UNIT_LIMIT=200000
PRIORITY_FEE_MICROLAMPORTS_PER_CU=100000

# Configure 1–4 independent friend/bot wallet pairs.
# Solana bot private keys are base58 secret-key strings — do not share them.
PAIR_1_NAME=friend1
PAIR_1_FRIEND_WALLET=
PAIR_1_BOT_PRIVATE_KEY=

PAIR_2_NAME=friend2
PAIR_2_FRIEND_WALLET=
PAIR_2_BOT_PRIVATE_KEY=

PAIR_3_NAME=friend3
PAIR_3_FRIEND_WALLET=
PAIR_3_BOT_PRIVATE_KEY=

PAIR_4_NAME=friend4
PAIR_4_FRIEND_WALLET=
PAIR_4_BOT_PRIVATE_KEY=
